# ════════════════════════════════════════════════════════════════════════
# Fallaman — configuration de production (OVH Cloud)
# Domaine : fallaman.gabomazone.com
#
# Copier vers `.env` à la racine Django (dossier Fallaman/) :
#   cp .env.production.example .env
# Puis renseigner CHAQUE secret. production.py refuse de démarrer sinon.
# ════════════════════════════════════════════════════════════════════════

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false

# Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Domaine public (jamais '*').
DJANGO_ALLOWED_HOSTS=fallaman.gabomazone.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://fallaman.gabomazone.com

# TLS terminé par nginx/Certbot sur l'hôte → Django fait confiance au proxy.
DJANGO_SECURE_SSL_REDIRECT=true
TRUST_PROXY_HEADERS=true

# Port HTTP exposé par le conteneur nginx (hôte).
# 80 si nginx Docker est public ; 8080 si un nginx hôte termine le TLS.
FALLAMAN_HTTP_PORT=8080
FALLAMAN_IMAGE_TAG=latest
CELERY_CONCURRENCY=2

# ── PostgreSQL (service Docker `db`) ────────────────────────────────────
POSTGRES_PASSWORD=

# DATABASE_URL est construit automatiquement par docker-compose.yml.
# Pour un Postgres managé OVH, décommente et adapte :
# DATABASE_URL=postgres://fallaman:MOTDEPASSE@hote-private:5432/fallaman

# ── Redis / Celery (services Docker) ────────────────────────────────────
# Injectés par docker-compose.yml ; à surcharger seulement hors Compose.
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Connexion des membres ───────────────────────────────────────────────
# OBLIGATOIRE : email (ou whatsapp). `console` est refusé en production.
OTP_PROVIDER=email
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Fallaman <no-reply@gabomazone.com>

# Canal alternatif : OTP_PROVIDER=whatsapp
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# ── SingPay (obligatoire en production) ─────────────────────────────────
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=production
SINGPAY_BASE_URL=
SINGPAY_LOGO_URL=
SINGPAY_WEBHOOK_SECRET=
SINGPAY_WEBHOOK_TOLERANCE_SECONDS=300
SINGPAY_WEBHOOK_REQUIRE_FRESH_TIMESTAMP=false

# ── Commodités de développement ─────────────────────────────────────────
# Forcées à false par production.py. Ne pas définir DEMO_STAFF_PASSWORD.
DEV_CONVENIENCES=false

# ── Durées métier ───────────────────────────────────────────────────────
LISTING_EMPLOYMENT_TTL_DAYS=30
LISTING_MISSION_TTL_DAYS=7
CONVERSATION_IDLE_HOURS=72
CONVERSATION_MAX_DAYS=7

# ── Téléversements ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880
MAX_LISTING_IMAGES=5

# ── Observabilité ───────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
ACTIVITY_LOG_RETENTION_DAYS=30

# ── Tarification boost (FCFA / jour) ─────────────────────────────────────
RECO_LISTING_DAILY_RATE=500
RECO_PROFILE_DAILY_RATE=400

# ── Liens stores (hors http(s) => popup « Bientôt disponible » + PWA) ───
ANDROID_APP_URL=#
IOS_APP_URL=#
