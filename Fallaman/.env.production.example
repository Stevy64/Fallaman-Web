# ════════════════════════════════════════════════════════════════════════
# Fallaman — configuration de production (PythonAnywhere)
# Copier en `.env` à la racine du projet, puis remplir CHAQUE valeur.
# `config/settings/production.py` refuse de démarrer si l'une des entrées
# critiques est laissée en l'état.
# ════════════════════════════════════════════════════════════════════════

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false

# Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Vos domaines, séparés par des virgules. Jamais '*'.
DJANGO_ALLOWED_HOSTS=votrecompte.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://votrecompte.pythonanywhere.com

# PythonAnywhere termine le TLS en amont : on fait confiance à
# X-Forwarded-Proto et X-Forwarded-For.
DJANGO_SECURE_SSL_REDIRECT=true
TRUST_PROXY_HEADERS=true

# ── Base de données ─────────────────────────────────────────────────────
# MySQL (inclus dans les offres PythonAnywhere) :
DATABASE_URL=mysql://votrecompte:MOTDEPASSE@votrecompte.mysql.pythonanywhere-services.com/votrecompte$fallaman
# PostgreSQL (offres payantes) :
# DATABASE_URL=postgres://user:pass@hote:port/fallaman

# ── Fichiers média ──────────────────────────────────────────────────────
MEDIA_ROOT=/home/votrecompte/fallaman-web/Fallaman/media

# ── Tâches de fond ──────────────────────────────────────────────────────
# PythonAnywhere n'héberge ni Redis ni worker Celery. On laisse ces valeurs
# vides : les tâches s'exécutent alors en direct, et la maintenance
# périodique passe par `manage.py run_maintenance` (Scheduled tasks).
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Connexion des membres ──────────────────────────────────────────────
# Première connexion : numéro + e-mail -> code par e-mail -> mot de passe.
# Connexions suivantes : numéro + mot de passe.
# OBLIGATOIRE : `console` fige le code et laisse entrer sur n'importe quel
# compte. La production refuse de démarrer avec cette valeur.
OTP_PROVIDER=email
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# SMTP — Brevo, Gmail (mot de passe d'application) ou tout autre relais.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Utilisez un domaine que vous contrôlez (SPF/DKIM) pour éviter les spams.
DEFAULT_FROM_EMAIL=Fallaman <no-reply@votredomaine.ga>

# Canal alternatif : OTP_PROVIDER=whatsapp (WhatsApp Cloud API de Meta).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# ── SingPay ─────────────────────────────────────────────────────────────
# Sans ces identifiants, le paiement est *indisponible* (et non gratuit).
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=production
# Secret HMAC des webhooks, si SingPay en fournit un distinct de l'API secret.
SINGPAY_WEBHOOK_SECRET=
SINGPAY_WEBHOOK_TOLERANCE_SECONDS=300
# Passer à true une fois le format de X-Timestamp confirmé (voir doc).
SINGPAY_WEBHOOK_REQUIRE_FRESH_TIMESTAMP=false
# Doit rester false : true crédite les recommandations sans encaisser.
SINGPAY_MOCK=false

# ── Commodités de développement ─────────────────────────────────────────
# Forcées à false par production.py. Ne pas définir DEMO_STAFF_PASSWORD.
DEV_CONVENIENCES=false

# ── Durées métier ───────────────────────────────────────────────────────
LISTING_EMPLOYMENT_TTL_DAYS=30
LISTING_MISSION_TTL_DAYS=7
CONVERSATION_IDLE_HOURS=72
CONVERSATION_MAX_DAYS=7

# ── Téléversements ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880
MAX_LISTING_IMAGES=5

# ── Observabilité ───────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
ACTIVITY_LOG_RETENTION_DAYS=30

# ── Tarification recommandations (FCFA / jour) ──────────────────────────
RECO_LISTING_DAILY_RATE=500
RECO_PROFILE_DAILY_RATE=400

# ── Liens stores ────────────────────────────────────────────────────────
ANDROID_APP_URL=#
IOS_APP_URL=#
