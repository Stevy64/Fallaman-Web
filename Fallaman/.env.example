# Fallaman — développement local
# Production OVH (fallaman.gabomazone.com) : copier .env.production.example → .env
# Voir docs/DEPLOIEMENT_OVH.md
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
# Code OTP fixe et compte équipe de démonstration.
# Interdit en production (production.py force la valeur à false).
DEV_CONVENIENCES=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL :
# DATABASE_URL=postgres://fallaman:fallaman@localhost:5432/fallaman

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=true

# console (dev) | email | whatsapp
OTP_PROVIDER=console
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DEV_CODE=123456

# ── Envoi du code d'activation ──────────────────────────────────────────
# En local, `console` affiche le code dans le terminal. Pour tester l'e-mail :
#   OTP_PROVIDER=email
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Fallaman <no-reply@fallaman.test>

# Canal alternatif : OTP_PROVIDER=whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_LANGUAGE=fr

# Compte équipe de démonstration (développement uniquement).
DEMO_STAFF_PHONE=+24106111111
DEMO_STAFF_PASSWORD=FallamanAdmin2026!

LISTING_EMPLOYMENT_TTL_DAYS=30
LISTING_MISSION_TTL_DAYS=7
CONVERSATION_IDLE_HOURS=72
CONVERSATION_MAX_DAYS=7

MEDIA_ROOT=
MAX_UPLOAD_SIZE=5242880
MAX_LISTING_IMAGES=5
# À activer uniquement derrière un proxy de confiance.
TRUST_PROXY_HEADERS=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
ACTIVITY_LOG_RETENTION_DAYS=30

# Liens boutons téléchargement app (accueil). Ex. Play Store / App Store.
# Tant que l'URL n'est pas http(s), un popup « Bientôt disponible » propose la PWA.
ANDROID_APP_URL=#
IOS_APP_URL=#

# SingPay — à copier dans `.env` (Django ne lit pas ce fichier).
# Identifiants Workspace : client.singpay.ga. Sans eux le paiement est indisponible.
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=sandbox
SINGPAY_BASE_URL=
SINGPAY_LOGO_URL=
# Secret HMAC des webhooks (à défaut : SINGPAY_API_SECRET).
SINGPAY_WEBHOOK_SECRET=
SINGPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Recommandations (FCFA / jour)
RECO_LISTING_DAILY_RATE=500
RECO_PROFILE_DAILY_RATE=400
