# Modèle du Secret du namespace fallaman.
# Sur le VPS : /etc/fallaman/app.env, mode 600. Ne pas commiter le fichier rempli.
# Générer la clé : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Le site public est fallaman.gabomazone.com.
# config.settings.production refuse de démarrer si la clé est vide ou connue,
# si ALLOWED_HOSTS contient *, si OTP_PROVIDER=console, si EMAIL_HOST est vide
# alors que le canal est l'e-mail, ou si un identifiant SingPay manque.
# Ne pas définir DEMO_STAFF_PASSWORD.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=remplacer-par-secrets.token_urlsafe-48
DJANGO_ALLOWED_HOSTS=fallaman.gabomazone.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://fallaman.gabomazone.com
DJANGO_SECURE_SSL_REDIRECT=true
TRUST_PROXY_HEADERS=true

DATABASE_URL=postgresql://fallaman:MOT@postgres.donnees.svc.cluster.local:5432/fallaman?sslmode=disable
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

OTP_PROVIDER=email
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Fallaman <no-reply@gabomazone.com>

SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=production
SINGPAY_WEBHOOK_SECRET=
# Callback : https://fallaman.gabomazone.com/paiements/singpay/callback/

DEV_CONVENIENCES=false
ANDROID_APP_URL=#
IOS_APP_URL=#
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
